    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
