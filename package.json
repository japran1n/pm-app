{
  "name": "pm-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:extension": "cd extension && npm run build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:realtime": "vitest run -c vitest.realtime.config.ts --no-file-parallelism",
    "seed:demo": "node --env-file=.env scripts/seed-demo.mjs",
    "seed:full-demo": "tsx --env-file=.env scripts/seed-full-demo.ts",
    "db:apply": "node --env-file=.env scripts/apply-migration.mjs",
    "db:gen-types": "node --env-file=.env scripts/gen-types.mjs",
    "migrations:check": "node --env-file=.env scripts/check-migration-drift.mjs",
    "realtime:check": "node --env-file=.env scripts/check-realtime-publication.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "node-html-parser": "^9.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
