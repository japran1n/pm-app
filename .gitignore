# --- CREDENTIALS ---
# Never commit any .env variant. .env.example is the only env file in git.
.env*
!.env.example

# --- MCP LOCAL CONFIG ---
# .mcp.json (committed) is a sanitized, read-only, no-project-ref template.
# .mcp.local.json holds the real project_ref plus write/migration tools for
# local development and must never be committed.
.mcp.local.json

# --- VERIFICATION SCRIPTS ---
# Connection verification scripts are temporary; they're deleted on PASS.
# Keep them out of git even before deletion.
missions/*/connections/verify/

# --- HOOK & TEST OUTPUT ---
/tmp/missions-test-output.log
/tmp/missions-verify-body

# --- OS NOISE ---
.DS_Store
Thumbs.db

# --- EDITOR NOISE ---
.vscode/
.idea/
*.swp
*.swo

# --- BUILD / DEPS (project will add its own) ---
node_modules/
dist/
build/
.next/
__pycache__/
*.pyc

# NOTE: do NOT ignore `missions/` in general — mission state IS the project's
# documentation. Only the verify/ subdirectory is excluded.
*.tsbuildinfo
supabase/.temp/

# Playwright (F090) run artifacts — traces/screenshots regenerated per run,
# never source.
/test-results/

# --- EXTENSION (F280) build artifacts ---
extension/dist.zip
extension/test-results/
extension/playwright-report/
/playwright-report/
/blob-report/
/playwright/.cache/

# ShipStudio metadata
.shipstudio/

# Playwright MCP session artifacts (console logs / page snapshots). These
# have captured live Supabase access/refresh tokens before — never commit.
.playwright-mcp/
