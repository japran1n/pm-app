# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only — never expose to the browser or commit a real value)
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# Sentry (optional at local-dev time; required before Vercel deploy)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Resend (transactional email — NOT connected yet; features F213-F217 are skipped until a key is provided)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Extension session handoff (F281, server-only — never expose to the browser
# or commit a real value). Encrypts the short-lived one-time token that lets
# the QA feedback browser extension pick up an already-signed-in web
# session without the user retyping credentials. Any random 32+ byte string.
EXTENSION_HANDOFF_SECRET=

# Extension task-creation CORS allowlist (F292, server-only). The QA
# feedback extension's own id, so app/api/extension/tasks/route.ts can
# restrict CORS to exactly `chrome-extension://<EXTENSION_ID>`. An
# unpacked/dev extension's id is randomly assigned by Chrome per load and
# is NOT the same as a Web-Store-published extension's stable id — set
# this to whatever id your local unpacked load shows at chrome://extensions
# during development, and to the published id once the extension ships.
EXTENSION_ID=

# Allows signing in with a bare username (resolved to the account email via
# the Supabase admin API) on top of the normal email + password sign-in.
# Convenience for testing with the demo accounts from `npm run seed:demo`.
# Defaults to on in development, off everywhere else.
ALLOW_USERNAME_LOGIN=true
