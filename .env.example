# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only — never expose to the browser or commit a real value)
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# Sentry (optional at local-dev time; required before Vercel deploy)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Resend (transactional email — NOT connected yet; features F213-F217 are skipped until a key is provided)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Extension session handoff (F281, server-only — never expose to the browser
# or commit a real value). Encrypts the short-lived one-time token that lets
# the QA feedback browser extension pick up an already-signed-in web
# session without the user retyping credentials. Any random 32+ byte string.
EXTENSION_HANDOFF_SECRET=
