# F281: values embedded into the built extension bundle at build time via
# Vite's `VITE_`-prefixed env vars (see vite.config.ts / import.meta.env).
#
# Only the publishable Supabase key belongs here. Never put
# SUPABASE_SECRET_KEY (or any `sb_secret_*` value) in this file — the
# build-time check in scripts/check-no-secret-key.mjs fails the build if
# one ever leaks into dist/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The pm-app web origin the extension talks to: where the popup opens
# /extension-connect, where the content script is allowed to run
# (extension-connect.ts, matched narrowly in manifest.json), and where the
# background service worker exchanges a handoff token for a session.
VITE_APP_URL=http://localhost:3000
