# F281: values embedded into the built extension bundle at build time via
# Vite's `VITE_`-prefixed env vars (see vite.config.ts / import.meta.env).
#
# Only the publishable Supabase key belongs here. Never put
# SUPABASE_SECRET_KEY (or any `sb_secret_*` value) in this file — the
# build-time check in scripts/check-no-secret-key.mjs fails the build if
# one ever leaks into dist/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The pm-app web origin the extension talks to: where the popup opens
# /extension-connect, where the content script is allowed to run
# (extension-connect.ts), and where the background service worker exchanges
# a handoff token for a session.
#
# vite.config.ts reads this value at build time (via Vite's loadEnv, not
# import.meta.env — that's not available in the config file itself) and
# generates manifest.json's host_permissions, content_scripts[].matches and
# web_accessible_resources[].matches from it. The committed manifest.json
# only holds a localhost placeholder for local dev; it is NOT the source of
# truth for these fields in a built artifact — the build throws if this
# variable is unset or not a valid URL, so it must be set before running
# `npm run build`.
VITE_APP_URL=http://localhost:3000
