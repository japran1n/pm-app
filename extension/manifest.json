{
  "manifest_version": 3,
  "name": "PM-App QA Feedback",
  "version": "0.1.0",
  "description": "Capture QA feedback (screenshot, console logs, page context) and file it as a pm-app task without leaving the page.",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PM-App QA Feedback",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/extension-connect*"],
      "js": ["src/content/extension-connect.ts"],
      "run_at": "document_idle"
    }
  ]
}
